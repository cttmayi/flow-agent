# Flow Agent 配置文件示例
# 使用方式：复制此文件为 config.yaml 并填入你的配置
# cp .flow-agent/config.yaml.example .flow-agent/config.yaml
#
# 注意：config.yaml 已在 .gitignore 中，不会被提交到版本控制。
# 推荐通过环境变量 ANTHROPIC_API_KEY 传递 API Key，优先级高于配置文件。

anthropic_api_key: "YOUR_API_KEY_HERE"

# API 地址（默认 Anthropic，可改为兼容端点）
base_url: "http://127.0.0.1:8080"

# 默认模型，agent() 未指定 model 时使用
default_model: "default"

# 默认超时（毫秒）
default_timeout: 120000